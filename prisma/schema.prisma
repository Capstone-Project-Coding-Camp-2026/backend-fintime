// FinTime Prisma Schema
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id               String   @id @default(cuid())
  fullName         String
  email            String   @unique
  password         String

  gender           String?              // male / female
  birthDate        DateTime?
  phone            String?
  monthlyIncome    Float?
  monthlyExpenses  Float? @default(0)
  currentSavings   Float? @default(0)

  retirementAge    Int?
  avatarCondition AvatarCondition @default(normal)

  jobType JobType?
  cityTier String? @default("tier_2")

  // Auto-label rules: [{match, category, include_expense}]
  labelRules        Json   @default("[]")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  transactions     Transaction[]
  linkedAccounts  LinkedAccount[]
  aggregations     Aggregation[]
  avatarState      AvatarState?

  // New relations for additional features
  budgets          Budget[]
  debts            Debt[]
  goals            Goal[]
  investments      Investment[]
  recurringTransactions RecurringTransaction[]
}

model Transaction {
  id              String   @id @default(cuid())

  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateTime        DateTime

  description     String

  amount          Float

  categoryLabel   String?

  confidence      Float?

  transactionType TransactionType

  paymentMethod   PaymentMethod?

  source          AccountSource?

  isLabelled      Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deletedAt       DateTime?

  @@index([userId])
  @@index([dateTime])
  @@index([categoryLabel])
  @@index([userId, dateTime])
}

model LinkedAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String              // bank / ewallet
  provider  AccountSource              // bca, mandiri, gopay, ovo, dll
  name          String              // Nama akun
  accountNumber String?             // Nomor rekening / telepon
  balance       Float   @default(0)
  currency      String  @default("IDR")
  isActive      Boolean @default(true)
  lastSynced    DateTime?
  apiToken      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, provider])
  @@unique([userId, provider, accountNumber])
}


model Aggregation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthYear   String               // Format YYYY-MM

  totalIncome Float   @default(0)
  totalExpense Float   @default(0)

  // Expense breakdown
  expenseHousing    Float @default(0)
  expenseFoodDrink       Float @default(0)
  expenseTransportation  Float @default(0)
  expenseEntertainment Float @default(0)
  expenseHealth     Float @default(0)
  expenseEducation   Float @default(0)
  expenseShopping    Float @default(0)
  expenseBills       Float @default(0)
  expenseInvestment Float @default(0)
  expenseOther       Float @default(0)

  // Calculated values
  savingsCapacity       Float @default(0)
  currentTotalBalance    Float @default(0)
  expenseToIncomeRatio   Float @default(0)
  savingsRate            Float @default(0)
  transactionCount       Int @default(0)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, monthYear])
  @@index([userId])
}

model AvatarState {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  condition            String               // good / normal / bad
  projectedWealth      Float   @default(0)
  pensionSurvivalYears Float   @default(0)

  // Rekomendasi investasi
  recommendedAssetClass String?

  // Prediksi pengeluaran 12 bulan ke depan (JSON array)
predictedExpenseTrend Json @default("[]")

  lastCalculated DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model Learning {
  id              String   @id @default(cuid())
  title           String
  content         String
  targetCondition String               // good / normal / bad / all
  category        String               // investasi / budgeting / utang / tabungan / pensiun

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

