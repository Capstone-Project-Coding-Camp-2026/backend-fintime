enum TransactionType {
  debit
  credit
}

enum PaymentMethod {
  tunai
  debit
  paylater
  ewallet
  credit
}

enum AvatarCondition {
  good
  normal
  bad
}

enum JobType {
  permanent
  freelance
  gig
  civil_servant
  entrepreneur
  not_working
}

enum AccountSource {
  bca
  mandiri
  bri
  bni
  btn
  cimb
  permata
  gopay
  ovo
  dana
  shopeepay
  linkaja
  lainnya
}

