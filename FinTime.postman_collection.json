    {
      "name": "Add Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('response status code should be 400', function () {\r",
              "    pm.response.to.have.status(400);\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "\r",
              "pm.environment.set(\"token\", json.data.token);\r",
              "pm.environment.set(\"user_id\", json.data.user.id);\r",
              "\r",
              "pm.test('response Content-Type header should contain application/json', function () {\r",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\r",
              "});\r",
              "\r",
              "pm.test('response body should be a valid object', function () {\r",
              "    const responseJson = pm.response.json();\r",
              "    pm.expect(responseJson).to.be.an('object');\r",
              "});\r",
              "\r",
              "pm.test('response body should have required properties', function () {\r",
              "    const responseJson = pm.response.json();\r",
              "\r",
              "    pm.expect(responseJson).to.have.property('status');\r",
              "    pm.expect(responseJson).to.have.property('message');\r",
              "});\r",
              "\r",
              "pm.test('response body should contain the correct error values', function () {\r",
              "    const responseJson = pm.response.json();\r",
              "\r",
              "    pm.expect(responseJson.status).to.eql('fail');\r",
              "    pm.expect(responseJson.message).to.eql('Gagal menambahkan user. Username sudah digunakan.');\r",
              "});\r",
              "\r",
              ""
            ],
