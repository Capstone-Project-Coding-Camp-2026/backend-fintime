    {
      "name": "Get Transactions",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type is application/json\", function () {\r",
              "    pm.expect(\r",
              "        pm.response.headers.get(\"Content-Type\")\r",
              "    ).to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response body is valid JSON object\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData).to.be.an(\"object\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response has required properties\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData).to.have.property(\"success\");\r",
              "    pm.expect(jsonData).to.have.property(\"data\");\r",
              "    pm.expect(jsonData).to.have.property(\"pagination\");\r",
              "});\r",
              "\r",
              "pm.test(\"Success should be true\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.success).to.eql(true);\r",
              "});\r",
              "\r",
              "pm.test(\"Data should be an array\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.data).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Pagination structure is valid\", function () {\r",
              "    const pagination = pm.response.json().pagination;\r",
              "\r",
              "    pm.expect(pagination).to.have.property(\"page\");\r",
              "    pm.expect(pagination).to.have.property(\"limit\");\r",
              "    pm.expect(pagination).to.have.property(\"total\");\r",
              "    pm.expect(pagination).to.have.property(\"pages\");\r",
              "});\r",
              "\r",
              "pm.test(\"Each transaction has required fields\", function () {\r",
              "    const transactions = pm.response.json().data;\r",
              "\r",
              "    if (transactions.length > 0) {\r",
              "        const trx = transactions[0];\r",
              "\r",
              "        pm.expect(trx).to.have.property(\"id\");\r",
              "        pm.expect(trx).to.have.property(\"userId\");\r",
              "        pm.expect(trx).to.have.property(\"description\");\r",
              "        pm.expect(trx).to.have.property(\"amount\");\r",
              "        pm.expect(trx).to.have.property(\"transactionType\");\r",
              "        pm.expect(trx).to.have.property(\"createdAt\");\r",
              "    }\r",
              "});\r",
              "\r",
              "pm.test(\"Limit does not exceed requested size\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.data.length).to.be.at.most(10);\r",
              "});\r",
              "\r",
              "pm.test(\"All transactions belong to logged in user\", function () {\r",
              "    const transactions = pm.response.json().data;\r",
              "    const expectedUserId = pm.environment.get(\"user_id\");\r",
              "\r",
              "    transactions.forEach((trx) => {\r",
              "        pm.expect(trx.userId).to.eql(expectedUserId);\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
