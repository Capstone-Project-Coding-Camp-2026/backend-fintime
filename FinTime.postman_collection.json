    {
      "name": "Add Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test('Register success', function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.success).to.eql(true);\r",
              "    pm.expect(jsonData.message).to.eql('Register successful');\r",
              "});\r",
              "\r",
              "pm.test('Response contains user data', function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.data).to.have.property('id');\r",
              "    pm.expect(jsonData.data).to.have.property('email');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
