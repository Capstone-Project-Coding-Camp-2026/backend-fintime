# Dibaca oleh Express.js untuk menentukan port server berjalan
PORT=5000

# Dibaca oleh library 'mongoose' di src/config/db.js untuk konek ke MongoDB Atlas
MONGODB_URI=mongodb+srv://<USERNAME_KAMU>:<PASSWORD_KAMU>@cluster0.xxxxx.mongodb.net/fintime?retryWrites=true&w=majority

# Dibaca oleh library 'jsonwebtoken' (jwt) di src/routes/auth.js & src/middleware/auth.js
JWT_SECRET=ini_harus_string_panjang_dan_acak_minimal_32_karakter

# Dibaca oleh library 'axios' di src/routes/ai.js untuk nembak ke service AI lokal
FASTAPI_URL=http://localhost:8000

# Dibaca oleh 'axios' sebagai header tambahan untuk keamanan jalur komunikasi ke FastAPI
INTERNAL_SECRET=RAHASIA_KUAT_123

# Dibaca oleh library 'cors' di src/app.js agar frontend Vite bisa mengakses backend
FRONTEND_URL=http://localhost:5173

# Penanda mode environment saat ini
NODE_ENV=development